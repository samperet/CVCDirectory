# Cloudflare R2 — where all app data lives (JSON documents and images).
# Without these, data falls back to local .data/ files (ephemeral on Vercel).
# (src/lib/storage.ts also accepts R2_TOKEN_ID + R2_API_TOKEN in place of the
# access key pair, or everything in one JSON value as R2 / R2_CONFIG / R2_CREDENTIALS.)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Signs session cookies. Set a long random value in production.
AUTH_SECRET=""

# Enables the admin API: directory import (PUT /api/admin/directory) and photo seeding
# (POST /api/admin/photos). Leave unset to disable it.
ADMIN_TOKEN=""
# Extra app admins, as comma-separated directory person ids (Sam Peret is built in)
ADMIN_PERSON_IDS=""

# Web push notifications (optional): generate with `npx web-push generate-vapid-keys`.
# Without them, the app generates a pair on first use and keeps it in storage.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:someone@example.org"
