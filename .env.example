# Cloudflare R2 — where all app data lives (JSON documents and images).
# Without these, data falls back to local .data/ files (ephemeral on Vercel).
# (src/lib/storage.ts also accepts R2_TOKEN_ID + R2_API_TOKEN in place of the
# access key pair, or everything in one JSON value as R2 / R2_CONFIG / R2_CREDENTIALS.)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Signs session cookies. Set a long random value in production.
AUTH_SECRET=""

# Enables the admin API: directory import (PUT /api/admin/directory) and photo seeding
# (POST /api/admin/photos). Leave unset to disable it.
ADMIN_TOKEN=""
# Extra app admins, as comma-separated directory person ids (Sam Peret is built in)
ADMIN_PERSON_IDS=""

# Web push notifications (optional): generate with `npx web-push generate-vapid-keys`.
# Without them, the app generates a pair on first use and keeps it in storage.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:someone@example.org"

# Email through Resend (optional): without RESEND_KEY nothing is emailed. Admins choose test
# mode and its allowed addresses at /admin/email. EMAIL_FROM's domain must be verified in Resend.
RESEND_KEY=
EMAIL_FROM=
# The app's address for links in emails (defaults to Vercel's production domain).
SITE_URL=

# Drawing new circles' icons (optional): OpenAI's image model, given the other circles' icons as
# references. Without OPENAI_KEY, new circles start without an icon (upload one as before).
OPENAI_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Circle email groups: receiving (Resend webhook signing secret, whsec_…), the daily cron, the
# email allowance (defaults: Resend's free plan), and the circles' address domain.
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
# EMAIL_DAILY_LIMIT=100
# EMAIL_MONTHLY_LIMIT=3000
# GROUP_EMAIL_DOMAIN=commonpasturesvt.org
